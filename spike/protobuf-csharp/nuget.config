<?xml version="1.0" encoding="utf-8"?>
<!-- El spike solo necesita nuget.org; se limpia la config global de la maquina
     (que trae feeds privados con credenciales ajenas a este proyecto). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
